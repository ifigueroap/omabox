#!/usr/bin/env bash
# omabox — Rambox-like web apps for Omarchy.
# Config, window class, and Hyprland snippets live in lib/omabox.py.
# This script launches Chromium and talks to Hyprland.

set -euo pipefail

SOURCE=$(readlink -f "$0")
ROOT=$(CDPATH='' cd -- "$(dirname "$SOURCE")/.." && pwd)
LIB="$ROOT/lib/omabox.py"

die() {
  echo "omabox: $*" >&2
  exit 1
}

python() {
  command python3 "$LIB" "$@"
}

have() {
  command -v "$1" >/dev/null 2>&1
}

# Same browser choice as Omarchy's bin/omarchy-launch-webapp. Omabox does not
# call omarchy-cmd-browser-handoff: that would open the URL in the default
# profile instead of the shared Omabox user-data-dir.
resolve_browser() {
  local require_bin=${1:-1}
  local browser="" desktop="" candidate=""
  if have omarchy-cmd-default-browser; then
    browser=$(omarchy-cmd-default-browser || true)
  fi
  case $browser in
    google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
    *) browser="chromium.desktop" ;;
  esac
  local dir
  for dir in "$HOME/.local/share/applications" "$HOME/.nix-profile/share/applications" /usr/share/applications; do
    [[ -f $dir/$browser ]] || continue
    desktop=$dir/$browser
    break
  done
  if [[ -n $desktop ]]; then
    candidate=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$desktop" | head -n 1)
  fi
  if [[ -n $candidate ]]; then
    printf '%s\n' "$candidate"
    return
  fi
  if have chromium; then
    printf '%s\n' chromium
  elif have google-chrome; then
    printf '%s\n' google-chrome
  elif [[ $require_bin == 1 ]]; then
    die "no Chromium-based browser found"
  else
    printf '%s\n' chromium
  fi
}

print_launch() {
  local browser=$1
  shift
  local wrapper="direct"
  if have uwsm-app; then
    wrapper="uwsm-app"
  fi
  printf 'wrapper %s\n' "$wrapper"
  printf 'browser %s\n' "$browser"
  printf 'argv'
  local arg
  for arg in "$@"; do
    printf ' %q' "$arg"
  done
  printf '\n'
}

run_launch() {
  local browser=$1
  shift
  # setsid detaches the browser from this script. The script then waits for
  # the window; the browser must outlive that wait.
  if have uwsm-app; then
    setsid uwsm-app -- "$browser" "$@" >/dev/null 2>&1 &
  else
    setsid "$browser" "$@" >/dev/null 2>&1 &
  fi
}

# Quattro hyprctl evaluates `dispatch` arguments as Lua. A keyword such as
# `togglespecialworkspace omabox` is parsed like dispatch(togglespecialworkspace omabox)
# and fails with `')' expected near 'omabox'`. The expressions below match
# https://wiki.hypr.land/Configuring/Basics/Dispatchers/ and Omarchy's scratchpad
# binds in default/hypr/bindings/tiling.lua.
lua_escape() {
  local text=$1
  text=${text//\\/\\\\}
  text=${text//\"/\\\"}
  printf '%s' "$text"
}

dispatch_expr_toggle() {
  printf '%s' 'hl.dsp.workspace.toggle_special("omabox")'
}

dispatch_expr_move() {
  local class=$1
  printf 'hl.dsp.window.move({ workspace = "special:omabox", follow = false, window = "class:%s" })' "$(lua_escape "$class")"
}

dispatch_expr_focus() {
  local class=$1
  printf 'hl.dsp.focus({ window = "class:%s" })' "$(lua_escape "$class")"
}

run_dispatch() {
  hyprctl dispatch "$1"
}

print_dispatch() {
  printf "hyprctl dispatch '%s'\n" "$1"
}

# Window rules use workspace = "special:omabox silent" (Hyprland allows a
# trailing " silent" on a workspace rule). The window maps onto a hidden
# special workspace. Toggle that workspace only after the window exists;
# an empty special workspace does not stay open.
wait_and_show() {
  local class_name=$1
  local ticks=${OMABOX_WINDOW_WAIT_TICKS:-80}
  local i
  for (( i = 0; i < ticks; i++ )); do
    if window_open "$class_name"; then
      reveal_window "$class_name"
      return 0
    fi
    sleep 0.25
  done
  return 1
}

special_shown() {
  have hyprctl || return 1
  hyprctl -j monitors 2>/dev/null | python3 -c '
import json, sys
try:
    monitors = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for monitor in monitors:
    name = ((monitor.get("specialWorkspace") or {}).get("name")) or ""
    if name in ("special:omabox", "omabox"):
        sys.exit(0)
sys.exit(1)
'
}

window_open() {
  local class_name=$1
  have hyprctl || return 1
  hyprctl -j clients 2>/dev/null | python3 -c '
import json, sys
wanted = sys.argv[1]
try:
    clients = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for client in clients:
    if client.get("class") == wanted or client.get("initialClass") == wanted:
        sys.exit(0)
sys.exit(1)
' "$class_name"
}

show_special() {
  if special_shown; then
    return 0
  fi
  run_dispatch "$(dispatch_expr_toggle)"
}

reveal_window() {
  local class_name=$1
  run_dispatch "$(dispatch_expr_move "$class_name")"
  show_special
  run_dispatch "$(dispatch_expr_focus "$class_name")"
}

# One Chromium process owns every Omabox profile (one --user-data-dir).
# A second --app launch is handed to that process; if it never maps a window,
# restarting the process is what creates a new one.
restart_omabox_chromium() {
  local user_data=$1
  local pids pid
  pids=$(python chromium-pids "$user_data" || true)
  if [[ -z ${pids//[[:space:]]/} ]]; then
    return 1
  fi
  echo "omabox: Chromium has the Omabox session but Hyprland has no window for this service." >&2
  echo "omabox: restarting that browser. Every Omabox profile shares this process, so the others close too." >&2
  while IFS= read -r pid; do
    [[ -n $pid ]] || continue
    kill "$pid" 2>/dev/null || true
  done <<<"$pids"
  local ticks=${OMABOX_CHROME_EXIT_TICKS:-20}
  local i
  for (( i = 0; i < ticks; i++ )); do
    pids=$(python chromium-pids "$user_data" || true)
    if [[ -z ${pids//[[:space:]]/} ]]; then
      return 0
    fi
    sleep 0.25
  done
  while IFS= read -r pid; do
    [[ -n $pid ]] || continue
    kill -KILL "$pid" 2>/dev/null || true
  done <<<"$pids"
  sleep 0.25
  return 0
}

open_service() {
  local ident=$1
  local spec browser class_name user_data
  spec=$(python launch-spec "$ident")
  class_name=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["class"])' <<<"$spec")
  user_data=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["userDataDir"])' <<<"$spec")
  local -a args=()
  local arg
  while IFS= read -r arg; do
    args+=("$arg")
  done < <(python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["args"]))' <<<"$spec")
  if have hyprctl && window_open "$class_name"; then
    reveal_window "$class_name"
    return 0
  fi
  browser=$(resolve_browser 1)
  echo "omabox: launching ${ident}" >&2
  run_launch "$browser" "${args[@]}"
  if ! have hyprctl; then
    return 0
  fi
  if wait_and_show "$class_name"; then
    return 0
  fi
  if restart_omabox_chromium "$user_data"; then
    echo "omabox: launching ${ident} again" >&2
    run_launch "$browser" "${args[@]}"
    if wait_and_show "$class_name"; then
      return 0
    fi
  fi
  echo "omabox: no window appeared for class ${class_name}" >&2
  echo "omabox: try: omabox launch ${ident} --print" >&2
  return 1
}

cmd_launch() {
  local ident=${1:?service id or key}
  if [[ ${2:-} == --print ]]; then
    local spec browser
    spec=$(python launch-spec "$ident")
    browser=$(resolve_browser 0)
    local -a args=()
    local arg
    while IFS= read -r arg; do
      args+=("$arg")
    done < <(python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["args"]))' <<<"$spec")
    print_launch "$browser" "${args[@]}"
    return
  fi
  open_service "$ident"
}

cmd_toggle() {
  if [[ ${1:-} == --print ]]; then
    print_dispatch "$(dispatch_expr_toggle)"
    return
  fi
  have hyprctl || die "hyprctl is not available"
  run_dispatch "$(dispatch_expr_toggle)"
}

cmd_focus() {
  local ident=${1:?service id or key}
  if [[ ${2:-} == --print ]]; then
    local spec class_name
    spec=$(python launch-spec "$ident")
    class_name=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["class"])' <<<"$spec")
    printf 'class %s\n' "$class_name"
    print_dispatch "$(dispatch_expr_move "$class_name")"
    print_dispatch "$(dispatch_expr_toggle)"
    print_dispatch "$(dispatch_expr_focus "$class_name")"
    return
  fi
  have hyprctl || die "hyprctl is not available"
  open_service "$ident"
}

cmd_dashboard() {
  have omarchy-shell || die "omarchy-shell is not available"
  omarchy-shell omabox dashboard
}

usage() {
  cat <<'USAGE'
Usage: omabox <command> [args]

  init                         Write ~/.config/omabox/services.toml if missing
  list [--json]                List services
  add [preset] [options]       Add a preset or a custom service
  remove <id>                  Remove a service
  launch <id|1-9> [--print]    Open the service in the shared Chromium
  focus <id|1-9> [--print]     Focus it on the omabox workspace, or launch it
  toggle [--print]             Toggle Hyprland special workspace omabox
  dashboard                    Open the dock's service dashboard
  setup [--menu]               Install keybinds, window rules, and ~/.local/bin/omabox
  uninstall [--purge]          Remove those integrations
  fetch-icons                  Cache favicons for services without a bundled icon
  class <url> <profile>        Print the Chromium window class

add options: --id --name --url --icon --profile --key --unread --update

Keys, once `omabox setup` has been reloaded by Hyprland:
  SUPER+ALT+O        toggle the omabox workspace
  SUPER+ALT+1..9     focus the service whose key is that digit

SUPER+O is Omarchy's "Pop window out" bind, and SUPER+SHIFT+O launches
Obsidian while preinstalled binds are on. The generated toggle uses the free
SUPER+ALT+O chord. Edit the o.bind line in ~/.config/hypr/omabox.lua to change
it. If the chord you want is already taken, use o.rebind with the same
arguments, then run: hyprctl reload && hyprctl configerrors
`omabox setup` rewrites omabox.lua, so re-apply a custom chord after setup.
USAGE
}

main() {
  local cmd=${1:-}
  if [[ -z $cmd || $cmd == -h || $cmd == --help ]]; then
    usage
    exit 0
  fi
  shift
  case $cmd in
    init | list | add | remove | setup | uninstall | fetch-icons | class | get | rules)
      python "$cmd" "$@"
      if [[ $cmd == setup ]] && have hyprctl; then
        hyprctl reload >/dev/null 2>&1 || true
        hyprctl configerrors || true
      fi
      ;;
    launch) cmd_launch "$@" ;;
    focus) cmd_focus "$@" ;;
    toggle) cmd_toggle "$@" ;;
    dashboard) cmd_dashboard "$@" ;;
    *)
      die "unknown command '$cmd' (try omabox --help)"
      ;;
  esac
}

main "$@"
